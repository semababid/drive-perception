# Keep the build context small and the image clean. The 18 GB dataset above all must
# never enter the context, and the torch weights are not used by the ONNX service.
.venv/
data/
runs/
outputs/
reports/
notebooks/
docs/
tests/
.git/
.github/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
*.pt
*.engine
